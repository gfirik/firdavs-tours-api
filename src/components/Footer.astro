---
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { AGENCY } from '../lib/site';
interface Props { note?: string }
const { note = 'Prices are 2026 estimates in USD per person, confirmed by a consultant before booking.' } = Astro.props;
---
<footer class="site-footer">
  <div class="wrap agency" data-agency-line>
    <p><strong>Demo by fhsystems.</strong> Want an AI agent like this for your business?</p>
    <a class="btn btn-ghost build" href={AGENCY.link('footer')} rel="noopener" data-agency="footer">Build mine <Icon name="arrow" /></a>
  </div>
  <div class="wrap grid">
    <div class="about">
      <a class="brand" href="/" aria-label="Firdavs Tours, home"><Mark size={32} /><span>Firdavs Tours</span></a>
      <p>Private and small-group journeys across Uzbekistan, planned in English, Uzbek or Russian.</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        <li><a href="/#tours">Tours</a></li>
        <li><a href="/#how">How it works</a></li>
        <li><a href="/#faq">FAQ</a></li>
        <li><a href="/plan">Plan my trip</a></li>
        <li><a href="/about">About this project</a></li>
        <li><a href="/credits">Photo credits</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap base">
    <p>{note}</p>
    <a class="badge" href={AGENCY.url} rel="noopener" data-agency="footer_badge">Built by <strong>fhsystems</strong></a>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--bg-deep); }
  .agency {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px;
    padding-block: 18px; margin-bottom: 44px; border-bottom: 1px solid var(--line-soft); color: var(--muted);
  }
  .agency strong { color: var(--text); font-weight: 600; }
  .build { min-height: 42px; padding: 0 18px; font-size: 0.95rem; white-space: nowrap; }
  .grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 32px 64px; padding-bottom: 40px; }
  .about { max-width: 26rem; display: grid; gap: 14px; }
  .about p { color: var(--muted); }
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-family: var(--serif); font-weight: 600; font-size: 1.35rem; }
  nav ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(150px, auto)); gap: 4px 40px; }
  nav a { display: inline-block; padding: 8px 0; color: var(--muted); text-decoration: none; }
  nav a:hover { color: var(--text); text-decoration: underline; }
  .base { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-block: 22px 32px; border-top: 1px solid var(--line-soft); color: var(--muted); font-size: 0.92rem; }
  .badge { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line); text-decoration: none; color: var(--muted); font-size: 0.88rem; white-space: nowrap; transition: border-color 0.2s, color 0.2s; }
  .badge strong { color: var(--text); font-weight: 600; }
  .badge:hover { border-color: var(--turq-ink); color: var(--text); }
</style>
