---
import Mark from './Mark.astro';
import Icon from './Icon.astro';
const links = [
  { href: '/#tours', label: 'Tours' },
  { href: '/#how', label: 'How it works' },
  { href: '/#faq', label: 'FAQ' },
];
---
<header class="site-header">
  <a class="skip" href="#main">Skip to content</a>
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Firdavs Tours, home">
      <Mark size={36} />
      <span>Firdavs Tours</span>
    </a>
    <nav class="nav" aria-label="Main">
      <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <div class="actions">
      <a class="btn btn-primary cta" href="/plan">Plan my trip</a>
      <details class="menu">
        <summary aria-label="Menu"><Icon name="menu" /></summary>
        <ul class="menu-panel">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href="/about">About this project</a></li>
        </ul>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.3) blur(14px);
    -webkit-backdrop-filter: saturate(1.3) blur(14px);
    border-bottom: 1px solid color-mix(in oklab, var(--line) 55%, transparent);
  }
  .bar { display: flex; align-items: center; gap: 24px; min-height: 72px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-family: var(--serif); font-weight: 600; font-size: 1.4rem; letter-spacing: 0.005em; white-space: nowrap; }
  .nav { margin-left: auto; }
  .nav ul { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .nav a { display: block; padding: 10px 14px; border-radius: 999px; text-decoration: none; color: var(--muted); font-weight: 500; transition: color 0.2s, background-color 0.2s; }
  .nav a:hover { color: var(--text); background: color-mix(in oklab, var(--surface-2) 70%, transparent); }
  .actions { display: flex; align-items: center; gap: 8px; }
  .cta { min-height: 44px; padding: 0 18px; font-size: 0.97rem; white-space: nowrap; }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 999px; border: 1px solid var(--line); cursor: pointer; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary :global(svg) { width: 20px; height: 20px; }
  .menu-panel {
    position: absolute; right: 0; top: calc(100% + 10px); min-width: 220px;
    list-style: none; margin: 0; padding: 8px; border-radius: var(--radius);
    background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow);
  }
  .menu-panel a { display: block; padding: 12px 14px; border-radius: 10px; text-decoration: none; }
  .menu-panel a:hover { background: var(--surface-2); }
  @media (max-width: 760px) {
    .nav { display: none; }
    .actions { margin-left: auto; }
    .menu { display: block; }
  }
  @media (max-width: 420px) {
    .bar { gap: 10px; }
    .brand { font-size: 1.15rem; gap: 8px; }
    .brand :global(svg) { width: 30px; height: 30px; }
    .cta { padding: 0 13px; font-size: 0.9rem; min-height: 40px; }
    .menu summary { width: 40px; height: 40px; }
  }
</style>
