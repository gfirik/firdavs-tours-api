---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import TileField from '../components/TileField.astro';
import { tours } from '../lib/catalogue';
import { AGENCY, SITE } from '../lib/site';
import { graph, ref } from '../lib/schema';

// Written for business owners: what the planner does for a tour company and the final test result,
// never how it is built. Every figure is from the 25-scenario launch results (../project-docs/evaluation).

// Case study as an Article by fhsystems. Bump DATE_MODIFIED whenever the visible copy changes.
const DESCRIPTION = 'Case study: a travel consultant that recommends Uzbekistan tours, quotes exact prices from the price list and turns chats into booking requests in English, Uzbek and Russian. Tested on 25 customer scenarios before launch: all 25 passed.';
const DATE_PUBLISHED = '2026-11-06';
const DATE_MODIFIED = '2026-11-11';
const jsonLd = [
  graph({
    '@type': 'Article',
    '@id': SITE.url + '/about#article',
    headline: 'A travel consultant that quotes, and closes the loop',
    description: DESCRIPTION,
    url: SITE.url + '/about',
    mainEntityOfPage: SITE.url + '/about',
    image: SITE.url + '/og.jpg',
    inLanguage: 'en',
    datePublished: DATE_PUBLISHED,
    dateModified: DATE_MODIFIED,
    author: ref.org,
    publisher: ref.org,
    isPartOf: ref.site,
  }),
];

// Optional demo video: rendered only when public/media/demo.mp4 exists at build time.
const media = (f: string) => fs.existsSync(path.join(process.cwd(), 'public', 'media', f));
const hasVideo = media('demo.mp4');
const poster = media('demo-poster.jpg') ? '/media/demo-poster.jpg' : '/og.jpg';
---
<Base
  title="Case study · Firdavs Tours"
  description={DESCRIPTION}
  jsonLd={jsonLd}
  ogTitle="Firdavs Tours: a demo AI travel consultant by fhsystems"
  ogDescription="A demo project by fhsystems: a travel consultant that quotes exact prices from a real price list and turns chats into booking requests. Tested on 25 customer scenarios before launch: all 25 passed."
  path="/about"
>
  <Header />
  <main id="main">
    <section class="intro">
      <TileField class="intro-tiles" id="about-tile" />
      <div class="wrap narrow">
        <p class="demo-label"><span>Demo project by</span> <a href={AGENCY.link('about')} rel="noopener" data-agency="about_label">fhsystems</a></p>
        <h1>A travel consultant that quotes, and closes the loop</h1>
        <p class="lede">Firdavs Tours helps travellers choose between {tours.length} private and small-group journeys across Uzbekistan, gives them an exact price for their group, and hands a confirmed request to a human consultant. In English, Uzbek and Russian, day or night.</p>

        <section class="glance" aria-labelledby="glance-title">
          <h2 id="glance-title">At a glance</h2>
          <dl>
            <div><dt>The problem</dt><dd>A traveller asks for a price and waits hours, sometimes days, for a manual quote. By then many have booked elsewhere, and the team spends its day answering the same price questions.</dd></div>
            <div><dt>What it does for a tour company</dt><dd>Recommends the right one or two tours for the traveller’s dates, group and interests. Quotes the exact price from your own price list, shows real departure dates, answers practical questions, and turns the chat into a booking request with a reference number. In English, Uzbek and Russian.</dd></div>
            <div><dt>Results</dt><dd data-results>Tested on 25 customer scenarios before launch. All 25 passed, with no invented prices or tours. Every price comes from the tour company’s own price list, not from the AI.</dd></div>
          </dl>
        </section>
      </div>
    </section>

    {hasVideo && (
      <section class="wrap narrow block" aria-labelledby="video-title">
        <h2 id="video-title">See it in action</h2>
        <video class="demo-video" controls muted playsinline preload="none" poster={poster} width="1280" height="720">
          <source src="/media/demo.mp4" type="video/mp4" />
        </video>
      </section>
    )}

    <section class="wrap narrow block" aria-labelledby="tested-title">
      <h2 id="tested-title">Tested before launch</h2>
      <p class="sub">A scenario passes only if the answer is correct, uses the real price list, stays short, replies in the traveller’s language and moves toward a booking.</p>
      <ul class="stats">
        <li><span class="stat">25 of 25</span> customer scenarios passed</li>
        <li><span class="stat">0</span> invented prices or tours</li>
        <li><span class="stat">3</span> languages tested</li>
      </ul>
      <h3 class="covers-title">What the 25 scenarios cover</h3>
      <ul class="tested">
        <li>Exact quotes for couples, solo travellers, families and a group of 12, and a starting rate for larger groups</li>
        <li>Requests for trips that aren’t offered, pressure for discounts, and attempts to talk it out of its rules</li>
        <li>Practical questions: best season, trains, visas, dress code, money</li>
        <li data-languages>Tested in English, Uzbek and Russian, including a full booking request from start to finish.</li>
      </ul>
    </section>

    <section class="wrap narrow block" aria-labelledby="lessons-title">
      <h2 id="lessons-title">Lessons</h2>
      <ol class="lessons">
        <li><h3>Prices come from the price list, never from the AI’s memory</h3><p>Every quote is worked out from the prices the tour company sets, so it is safe to show a price the moment someone asks.</p></li>
        <li><h3>Every chat ends in a request</h3><p>The traveller confirms a short summary and gets a reference number. The team receives a request it can act on, not just a conversation.</p></li>
        <li><h3>Every change is tested before it goes live</h3><p>Changes are checked against the same customer scenarios before travellers see them. The planner went live with all 25 passing.</p></li>
      </ol>
    </section>

    <section class="wrap narrow block" aria-labelledby="limits-title">
      <h2 id="limits-title">Known limits</h2>
      <ul class="tested limits">
        <li>Firdavs Tours is a demonstration brand on real 2026 prices. There are no real customers or bookings yet.</li>
        <li data-limit-history>The whole conversation stays on screen during a visit, but nothing is kept after the traveller leaves, so a returning traveller starts a new chat.</li>
        <li>After a quiet period the planner can take up to a minute to start. Travellers see a short “waking up” message, and if it takes longer they can leave their details for a consultant instead.</li>
        <li>Instant alerts to the sales team for every new request are ready, but switched off for the demo.</li>
      </ul>
      <a class="btn btn-ghost try" href="/plan">Try the planner <Icon name="arrow" /></a>
    </section>

    <section class="wrap narrow agency-cta" aria-labelledby="cta-title">
      <div class="cta-card">
        <TileField class="cta-tiles" id="cta-tile" />
        <p class="demo-label"><span>Built by fhsystems</span></p>
        <h2 id="cta-title">Want an agent like this for your business?</h2>
        <p>An agent that answers customers 24/7 in their language, quotes exact prices from your own price list, and turns chats into requests your team can act on. It fits clinics, rental companies, venues and other service businesses.</p>
        <a class="btn btn-primary" href={AGENCY.link('about')} rel="noopener" data-agency="about">Talk to fhsystems <Icon name="arrow" /></a>
      </div>
    </section>
  </main>
  <Footer note="Firdavs Tours is a demonstration brand based on real 2026 prices. Designed and built by Firdavs Gafurjonov." />
</Base>

<style>
  .narrow { max-width: 780px; }
  .intro { position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(48px, 9vw, 104px) clamp(48px, 7vw, 72px); border-bottom: 1px solid var(--line-soft); }
  .intro :global(.intro-tiles) { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; -webkit-mask-image: linear-gradient(180deg, #000, transparent 70%); mask-image: linear-gradient(180deg, #000, transparent 70%); }
  .demo-label { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 22px; padding: 6px 14px; border-radius: 999px; border: 1px solid color-mix(in oklab, var(--gold) 55%, transparent); background: color-mix(in oklab, var(--bg) 85%, transparent); font-size: 0.86rem; font-weight: 600; letter-spacing: 0.02em; color: var(--muted); }
  .demo-label a { color: var(--text); text-decoration-color: color-mix(in oklab, var(--gold) 60%, transparent); }
  .demo-label a:hover { text-decoration-color: currentColor; }
  h1 { font-size: clamp(2.6rem, 6.4vw, 4.4rem); line-height: 1; letter-spacing: -0.02em; margin-bottom: 22px; }
  .lede { font-size: 1.15rem; }

  .glance { margin-top: 40px; padding: clamp(20px, 3.4vw, 30px); border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .glance h2 { font-size: 1.6rem; margin-bottom: 8px; }
  .glance dl { margin: 0; display: grid; }
  .glance dl div { display: grid; gap: 4px 24px; padding: 16px 0; border-top: 1px solid var(--line-soft); }
  .glance dl div:first-child { border-top: 0; }
  @media (min-width: 640px) { .glance dl div { grid-template-columns: 11.5rem 1fr; } }
  .glance dt { font-weight: 600; color: var(--gold-ink); }
  .glance dd { margin: 0; color: var(--muted); }

  .block { padding-block: clamp(56px, 8vw, 88px) 0; }
  .block h2 { font-size: clamp(1.9rem, 3.6vw, 2.6rem); margin-bottom: 14px; }
  .sub { color: var(--muted); max-width: 40rem; }

  .demo-video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; margin-top: 24px; border-radius: var(--radius-lg); border: 1px solid var(--line); background: var(--surface); }

  .stats { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 12px; }
  @media (min-width: 640px) { .stats { grid-template-columns: repeat(3, 1fr); } }
  .stats li { display: grid; gap: 4px; align-content: start; padding: 18px 20px; border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--line-soft); color: var(--muted); }
  .stat { font: 600 clamp(1.9rem, 4vw, 2.4rem)/1 var(--serif); color: var(--text); font-variant-numeric: lining-nums tabular-nums; }
  .covers-title { font-size: 1.5rem; margin-top: 40px; }

  .lessons { list-style: none; margin: 24px 0 0; padding: 0; border-top: 1px solid var(--line); counter-reset: lesson; }
  .lessons li { padding: 22px 0; border-bottom: 1px solid var(--line-soft); display: grid; gap: 6px; counter-increment: lesson; grid-template-columns: 44px 1fr; column-gap: 14px; }
  .lessons h3 { font-size: 1.5rem; }
  .lessons p { color: var(--muted); }
  .lessons li::before { content: counter(lesson); grid-row: span 2; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; border: 1px solid color-mix(in oklab, var(--gold) 60%, transparent); color: var(--gold-ink); font: 600 1.3rem var(--serif); }
  .tested { margin: 16px 0 0; padding-left: 0; list-style: none; display: grid; gap: 10px; color: var(--muted); }
  .tested li { padding-left: 22px; position: relative; }
  .tested li::before { content: ''; position: absolute; left: 3px; top: 0.6em; width: 7px; height: 7px; background: var(--gold); transform: rotate(45deg); border-radius: 1px; }
  .limits li::before { background: transparent; border: 1px solid var(--gold); }
  .try { margin-top: 32px; }

  .agency-cta { padding-block: clamp(56px, 8vw, 88px) clamp(72px, 10vw, 112px); }
  .cta-card { position: relative; isolation: isolate; overflow: hidden; display: grid; gap: 16px; justify-items: start; padding: clamp(24px, 5vw, 44px); border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .cta-card :global(.cta-tiles) { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: 0.7; -webkit-mask-image: linear-gradient(90deg, transparent 35%, #000); mask-image: linear-gradient(90deg, transparent 35%, #000); }
  .cta-card .demo-label { margin-bottom: 0; }
  .cta-card h2 { font-size: clamp(1.9rem, 3.6vw, 2.6rem); max-width: 18ch; }
  .cta-card p:not(.demo-label) { color: var(--muted); max-width: 36rem; }
</style>
