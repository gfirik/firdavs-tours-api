---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import TileField from '../components/TileField.astro';
import { tours } from '../lib/catalogue';
import { AGENCY } from '../lib/site';

// Figures from the 25-conversation test set results (runs 1, 2, 3a, 3b), see ../project-docs/evaluation.
const RUNS = [
  { run: 'Run 1', label: 'First build', pass: 12 },
  { run: 'Run 2', label: 'Prompt fixes', pass: 19 },
  { run: 'Run 3a', label: 'After redesign', pass: 11, regress: true },
  { run: 'Run 3b', label: 'Launch', pass: 25 },
];
const TOTAL = 25;
const pct = (n: number) => Math.round((n / TOTAL) * 100);

// Column chart geometry (viewBox units). One scale for bars, gridlines and labels.
const C = { left: 44, right: 350, top: 28, base: 198 };
const H = C.base - C.top;
const colW = 50;
const step = (C.right - C.left) / RUNS.length;
const y = (p: number) => C.base - (p / 100) * H;
const bar = (x: number, top: number, w: number, r = 4) =>
  `M${x},${C.base}V${top + r}Q${x},${top} ${x + r},${top}H${x + w - r}Q${x + w},${top} ${x + w},${top + r}V${C.base}Z`;
const cols = RUNS.map((r, i) => {
  const cx = C.left + step * (i + 0.5);
  const p = pct(r.pass);
  return { ...r, p, cx, x: cx - colW / 2, top: y(p) };
});

// Optional demo video: rendered only when public/media/demo.mp4 exists at build time.
const media = (f: string) => fs.existsSync(path.join(process.cwd(), 'public', 'media', f));
const hasVideo = media('demo.mp4');
const poster = media('demo-poster.jpg') ? '/media/demo-poster.jpg' : '/og.jpg';
---
<Base
  title="How it was built · Firdavs Tours"
  description="Case study: a travel consultant in English, Uzbek and Russian that recommends Uzbekistan tours, quotes exact prices and hands confirmed requests to a human, tested on 25 real-world conversations."
  ogTitle="Firdavs Tours: a demo AI travel agent by fhsystems"
  ogDescription="A demo project by fhsystems: an AI travel consultant that quotes exact prices from a real price list and turns chats into booking requests, tested from 48% to 100% on 25 conversations."
  path="/about"
>
  <Header />
  <main id="main">
    <section class="intro">
      <TileField class="intro-tiles" id="about-tile" />
      <div class="wrap narrow">
        <p class="demo-label"><span>Demo project by</span> <a href={AGENCY.link('about')} rel="noopener" data-agency="about_label">fhsystems</a></p>
        <h1>A travel consultant that quotes, and closes the loop</h1>
        <p class="lede">Firdavs Tours helps travellers choose between {tours.length} private and small-group journeys across Uzbekistan, gives an exact price for their group, and hands a confirmed request to a human consultant. It speaks English, Uzbek and Russian.</p>

        <section class="glance" aria-labelledby="glance-title">
          <h2 id="glance-title">At a glance</h2>
          <dl>
            <div><dt>Problem</dt><dd>Tour sites make travellers dig through PDFs and contact forms, then wait for a manual quote. Leads go cold, and staff answer the same price questions all day.</dd></div>
            <div><dt>What the agent does</dt><dd>Asks only what it needs, recommends one or two of {tours.length} tours with an exact price for the group, shows real departure dates, answers practical questions, and turns the chat into a booking request with a reference number.</dd></div>
            <div><dt>Stack</dt><dd>Agent on Agentplace (Luna model). Pricing and booking API in Node.js on Vercel, with Upstash Redis. This site in Astro. Tests with Playwright.</dd></div>
            <div><dt>Results</dt><dd><span class="num">25</span>-case evaluation: <span class="num">48% → 76% → 44% → 100%</span>. <span class="num">0</span> invented prices or tours across all runs. Lighthouse <span class="num">100</span> on mobile and desktop.</dd></div>
          </dl>
        </section>
      </div>
    </section>

    {hasVideo && (
      <section class="wrap narrow block" aria-labelledby="video-title">
        <h2 id="video-title">See it in action</h2>
        <video class="demo-video" controls muted playsinline preload="none" poster={poster} width="1280" height="720">
          <source src="/media/demo.mp4" type="video/mp4" />
        </video>
      </section>
    )}

    <section class="wrap narrow block" aria-labelledby="runs-title">
      <h2 id="runs-title">Quality over four test runs</h2>
      <p class="sub">Strict pass rate on the same 25 scripted conversations. A pass must be correct, grounded in the price list, short, in the traveller’s language, and move toward a request.</p>
      <figure class="chart">
        <svg class="eval-chart" viewBox="0 0 360 250" role="img" aria-labelledby="eval-svg-title eval-svg-desc">
          <title id="eval-svg-title">Strict pass rate by test run</title>
          <desc id="eval-svg-desc">{cols.map((c) => `${c.run}, ${c.label}: ${c.pass} of ${TOTAL}, ${c.p}%`).join('. ')}.</desc>
          {[0, 50, 100].map((g) => (
            <g class="grid">
              <line x1={C.left - 6} x2={C.right} y1={y(g)} y2={y(g)} />
              <text x={C.left - 10} y={y(g) + 4} text-anchor="end">{g}%</text>
            </g>
          ))}
          {cols.map((c) => (
            <g class:list={['col', { regress: c.regress }]}>
              <path d={bar(c.x, c.top, colW)} />
              <text class="val" x={c.cx} y={c.top - 8} text-anchor="middle">{c.p}%</text>
              <text class="run" x={c.cx} y={C.base + 20} text-anchor="middle">{c.run}</text>
              <text class="lbl" x={c.cx} y={C.base + 36} text-anchor="middle">{c.label}</text>
            </g>
          ))}
          <line class="axis" x1={C.left - 6} x2={C.right} y1={C.base} y2={C.base} />
        </svg>
        <table class="sr-only">
          <caption>Strict pass rate by test run</caption>
          <thead><tr><th scope="col">Run</th><th scope="col">Passed</th><th scope="col">Rate</th></tr></thead>
          <tbody>{cols.map((c) => <tr><th scope="row">{c.run}, {c.label}</th><td>{c.pass} of {TOTAL}</td><td>{c.p}%</td></tr>)}</tbody>
        </table>
        <figcaption>Run 3a dropped because a change to the reply cards broke how tours rendered. The test suite caught it before launch, not a customer.</figcaption>
      </figure>
    </section>

    <section class="wrap narrow block" aria-labelledby="arch-title">
      <h2 id="arch-title">How it fits together</h2>
      <p class="sub">The agent never does arithmetic. It calls a small API for every price and every booking.</p>
      <figure class="arch">
        <svg viewBox="0 0 360 548" role="img" aria-labelledby="arch-svg-title arch-svg-desc">
          <title id="arch-svg-title">Architecture</title>
          <desc id="arch-svg-desc">The visitor asks a question on the landing page. It opens the AI planner on Agentplace, running the Luna model. The planner calls three functions: quote for exact prices, departures for group dates, and requests for bookings. Requests are saved in Upstash Redis, and a Telegram alert can notify the sales team.</desc>
          <defs>
            <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="tip" d="M0,1 L9,5 L0,9 Z" /></marker>
          </defs>
          <g class="edge">
            <path d="M180,44 V82" marker-end="url(#arrow)" />
            <path d="M180,140 V182" marker-end="url(#arrow)" />
            <path d="M180,240 V264 M59,264 H301" />
            <path d="M59,264 V288" marker-end="url(#arrow)" />
            <path d="M180,264 V288" marker-end="url(#arrow)" />
            <path d="M301,264 V288" marker-end="url(#arrow)" />
            <path d="M301,342 V386" marker-end="url(#arrow)" />
            <path class="off" d="M301,442 V476" marker-end="url(#arrow)" />
          </g>
          <g class="elabel">
            <text x="190" y="66">asks a question</text>
            <text x="190" y="166">question handed over</text>
            <text x="170" y="257" text-anchor="end">tool calls</text>
            <text x="311" y="368">saves</text>
          </g>
          <g class="node"><rect x="105" y="2" width="150" height="42" rx="12" /><text class="t" x="180" y="28" text-anchor="middle">Visitor</text></g>
          <g class="node"><rect x="40" y="84" width="280" height="56" rx="12" /><text class="t" x="180" y="108" text-anchor="middle">Landing page</text><text class="s" x="180" y="126" text-anchor="middle">tours.fhsystems.dev · Astro on Vercel</text></g>
          <g class="node key"><rect x="40" y="184" width="280" height="56" rx="12" /><text class="t" x="180" y="208" text-anchor="middle">AI planner</text><text class="s" x="180" y="226" text-anchor="middle">Agentplace · Luna model</text></g>
          <g class="node api"><rect x="4" y="290" width="110" height="52" rx="10" /><text class="t m" x="59" y="312" text-anchor="middle">/api/quote</text><text class="s" x="59" y="330" text-anchor="middle">exact price</text></g>
          <g class="node api"><rect x="125" y="290" width="110" height="52" rx="10" /><text class="t m" x="180" y="312" text-anchor="middle">/api/departures</text><text class="s" x="180" y="330" text-anchor="middle">group dates</text></g>
          <g class="node api"><rect x="246" y="290" width="110" height="52" rx="10" /><text class="t m" x="301" y="312" text-anchor="middle">/api/requests</text><text class="s" x="301" y="330" text-anchor="middle">booking request</text></g>
          <text class="note" x="120" y="364" text-anchor="middle">prices from one file: lib/tours.json</text>
          <g class="node"><rect x="246" y="388" width="110" height="54" rx="10" /><text class="t" x="301" y="411" text-anchor="middle">Upstash Redis</text><text class="s" x="301" y="429" text-anchor="middle">saved requests</text></g>
          <g class="node off"><rect x="246" y="478" width="110" height="54" rx="10" /><text class="t" x="301" y="501" text-anchor="middle">Telegram alert</text><text class="s" x="301" y="519" text-anchor="middle">sales team · off</text></g>
        </svg>
      </figure>
    </section>

    <section class="wrap narrow block" aria-labelledby="works-title">
      <h2 id="works-title">What makes it work</h2>
      <ul class="points">
        <li><h3>It closes the loop</h3><p>The traveller sees a summary, confirms, and gets a reference number. Retries never create a duplicate request.</p></li>
        <li><h3>Quote first, ask later</h3><p>It answers with a price straight away and asks at most one question per reply. Dates don’t change the price, so they never block a quote.</p></li>
        <li><h3>Honest when it can’t</h3><p>No invented discounts, no payments in chat, visa answers point to the official portal, and anything off-topic is politely declined.</p></li>
        <li><h3>Large groups handled properly</h3><p>Private groups of ten or more see a starting rate, and a consultant prepares their group price.</p></li>
      </ul>
    </section>

    <section class="wrap narrow block" aria-labelledby="lessons-title">
      <h2 id="lessons-title">Lessons</h2>
      <ol class="lessons">
        <li><h3>Prices belong in a tool, not in the prompt</h3><p>Moving every price out of the instructions and into a calculation the agent calls mattered more than any wording change. Across all runs, no price was invented.</p></li>
        <li><h3>Give the agent a real submit action</h3><p>A booking request the agent actually sends, with a reference number, turns a nice chat into something the sales team can act on.</p></li>
        <li><h3>Evaluate every change</h3><p>A redesign dropped the pass rate from 76% to 44%. The same 25 conversations caught it before launch, which is why every change gets the full suite.</p></li>
      </ol>
    </section>

    <section class="wrap narrow block" aria-labelledby="tested-title">
      <h2 id="tested-title">Tested on 25 real-world conversations</h2>
      <ul class="tested">
        <li>Exact quotes for couples, solo travellers, families and groups of 12 to 20</li>
        <li>Requests we don’t offer, discount pressure and attempts to override its rules</li>
        <li>Practical questions: seasons, trains, visas, dress code, money</li>
        <li>Full conversations in Uzbek and Russian, and booking capture end to end</li>
      </ul>
    </section>

    <section class="wrap narrow block" aria-labelledby="limits-title">
      <h2 id="limits-title">Known limits</h2>
      <ul class="tested limits">
        <li>Firdavs Tours is a demonstration brand on real 2026 prices. There are no real customers, bookings or revenue.</li>
        <li>The planner doesn’t keep chat history per visitor yet: a public agent can’t safely keep private history without sign-in. The plan is for the site to remember the session in the browser.</li>
        <li>Handing the first question from this site to the planner relies on an undocumented platform channel. If it fails, the question is copied so the traveller can paste it.</li>
        <li>Telegram alerts to the sales team are built but switched off for the demo.</li>
        <li>Custom domains on the agent platform are paid, so this site hosts the planner page and embeds the agent.</li>
      </ul>
      <h2 class="next-title">What comes next</h2>
      <p class="sub">Turn the 25 cases into an automated regression suite that runs on every instruction or design change, add ten more Uzbek and Russian edge cases, and track the share of conversations that end in a confirmed request.</p>
      <a class="btn btn-ghost try" href="/plan">Try the planner <Icon name="arrow" /></a>
    </section>

    <section class="wrap narrow agency-cta" aria-labelledby="cta-title">
      <div class="cta-card">
        <TileField class="cta-tiles" id="cta-tile" />
        <p class="demo-label"><span>Built by fhsystems</span></p>
        <h2 id="cta-title">Want an agent like this for your business?</h2>
        <p>An agent that answers customers 24/7 in their language, quotes exact prices from your own price list, and turns chats into requests your team can act on. It fits clinics, rental companies, venues and other service businesses.</p>
        <a class="btn btn-primary" href={AGENCY.link('about')} rel="noopener" data-agency="about">Talk to fhsystems <Icon name="arrow" /></a>
      </div>
    </section>
  </main>
  <Footer note="Firdavs Tours is a demonstration brand based on real 2026 prices. Designed and built by Firdavs Gafurjonov." />
</Base>

<style>
  .narrow { max-width: 780px; }
  .intro { position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(48px, 9vw, 104px) clamp(48px, 7vw, 72px); border-bottom: 1px solid var(--line-soft); }
  .intro :global(.intro-tiles) { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; -webkit-mask-image: linear-gradient(180deg, #000, transparent 70%); mask-image: linear-gradient(180deg, #000, transparent 70%); }
  .demo-label { display: inline-flex; align-items: center; gap: 6px; margin-bottom: 22px; padding: 6px 14px; border-radius: 999px; border: 1px solid color-mix(in oklab, var(--gold) 55%, transparent); background: color-mix(in oklab, var(--bg) 85%, transparent); font-size: 0.86rem; font-weight: 600; letter-spacing: 0.02em; color: var(--muted); }
  .demo-label a { color: var(--text); text-decoration-color: color-mix(in oklab, var(--gold) 60%, transparent); }
  .demo-label a:hover { text-decoration-color: currentColor; }
  h1 { font-size: clamp(2.6rem, 6.4vw, 4.4rem); line-height: 1; letter-spacing: -0.02em; margin-bottom: 22px; }
  .lede { font-size: 1.15rem; }

  .glance { margin-top: 40px; padding: clamp(20px, 3.4vw, 30px); border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .glance h2 { font-size: 1.6rem; margin-bottom: 8px; }
  .glance dl { margin: 0; display: grid; }
  .glance dl div { display: grid; gap: 4px 24px; padding: 16px 0; border-top: 1px solid var(--line-soft); }
  .glance dl div:first-child { border-top: 0; }
  @media (min-width: 640px) { .glance dl div { grid-template-columns: 10.5rem 1fr; } }
  .glance dt { font-weight: 600; color: var(--gold-ink); }
  .glance dd { margin: 0; color: var(--muted); }

  .block { padding-block: clamp(56px, 8vw, 88px) 0; }
  .block h2 { font-size: clamp(1.9rem, 3.6vw, 2.6rem); margin-bottom: 14px; }
  .sub { color: var(--muted); max-width: 40rem; }

  .demo-video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; margin-top: 24px; border-radius: var(--radius-lg); border: 1px solid var(--line); background: var(--surface); }

  .chart, .arch { margin: 32px 0 0; padding: clamp(16px, 3vw, 28px); background: var(--surface); border: 1px solid var(--line-soft); border-radius: var(--radius-lg); }
  .chart svg { display: block; width: 100%; max-width: 560px; height: auto; margin-inline: auto; overflow: visible; }
  .eval-chart .grid line { stroke: var(--line); stroke-width: 1; stroke-dasharray: 2 4; }
  .eval-chart .axis { stroke: var(--muted); stroke-width: 1; }
  .eval-chart text { fill: var(--muted); font: 500 11px var(--sans); }
  .eval-chart .col path { fill: var(--turq-ink); }
  .eval-chart .col.regress path { fill: var(--gold); }
  .eval-chart .val { fill: var(--text); font: 600 15px var(--sans); font-variant-numeric: tabular-nums; }
  .eval-chart .run { fill: var(--text); font: 600 12px var(--sans); }
  .eval-chart .lbl { fill: var(--muted); font: 400 11px var(--sans); }
  .chart figcaption { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--line-soft); color: var(--muted); font-size: 0.95rem; }

  .arch svg { display: block; width: 100%; max-width: 460px; height: auto; margin-inline: auto; }
  .arch .node rect { fill: var(--bg); stroke: var(--line); stroke-width: 1.2; }
  .arch .node.key rect { stroke: var(--turq-ink); stroke-width: 1.6; }
  .arch .node.api rect { stroke: color-mix(in oklab, var(--gold) 70%, transparent); }
  .arch .node.off rect { stroke-dasharray: 4 4; }
  .arch .t { fill: var(--text); font: 600 13px var(--sans); }
  .arch .t.m { font-size: 11.5px; }
  .arch .s { fill: var(--muted); font: 400 10.5px var(--sans); }
  .arch .edge path { fill: none; stroke: var(--muted); stroke-width: 1.3; }
  .arch .edge path.off { stroke-dasharray: 4 4; }
  .arch .tip { fill: var(--muted); stroke: none; }
  .arch .elabel text { fill: var(--muted); font: italic 400 10.5px var(--sans); }
  .arch .note { fill: var(--muted); font: 400 10.5px var(--sans); }

  .points, .lessons { list-style: none; margin: 24px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .points li, .lessons li { padding: 22px 0; border-bottom: 1px solid var(--line-soft); display: grid; gap: 6px; }
  .points h3, .lessons h3 { font-size: 1.5rem; }
  .points p, .lessons p { color: var(--muted); }
  .lessons { counter-reset: lesson; }
  .lessons li { counter-increment: lesson; grid-template-columns: 44px 1fr; column-gap: 14px; }
  .lessons li::before { content: counter(lesson); grid-row: span 2; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; border: 1px solid color-mix(in oklab, var(--gold) 60%, transparent); color: var(--gold-ink); font: 600 1.3rem var(--serif); }
  .tested { margin: 16px 0 0; padding-left: 0; list-style: none; display: grid; gap: 10px; color: var(--muted); }
  .tested li { padding-left: 22px; position: relative; }
  .tested li::before { content: ''; position: absolute; left: 3px; top: 0.6em; width: 7px; height: 7px; background: var(--gold); transform: rotate(45deg); border-radius: 1px; }
  .limits li::before { background: transparent; border: 1px solid var(--gold); }
  .next-title { margin-top: 48px; }
  .try { margin-top: 28px; }

  .agency-cta { padding-block: clamp(56px, 8vw, 88px) clamp(72px, 10vw, 112px); }
  .cta-card { position: relative; isolation: isolate; overflow: hidden; display: grid; gap: 16px; justify-items: start; padding: clamp(24px, 5vw, 44px); border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .cta-card :global(.cta-tiles) { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; opacity: 0.7; -webkit-mask-image: linear-gradient(90deg, transparent 35%, #000); mask-image: linear-gradient(90deg, transparent 35%, #000); }
  .cta-card .demo-label { margin-bottom: 0; }
  .cta-card h2 { font-size: clamp(1.9rem, 3.6vw, 2.6rem); max-width: 18ch; }
  .cta-card p:not(.demo-label) { color: var(--muted); max-width: 36rem; }
</style>
