---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import TileField from '../components/TileField.astro';
---
<Base title="Page not found · Firdavs Tours" description="This page doesn’t exist. Plan your trip to Uzbekistan or browse our journeys." path="/404" noindex>
  <Header />
  <main id="main" class="nf">
    <TileField class="nf-tiles" id="nf-tile" />
    <div class="wrap inner">
      <p class="code num">404</p>
      <h1>This road leads nowhere</h1>
      <p class="lede">The page you were looking for isn’t here. The rest of the Silk Road is.</p>
      <div class="row">
        <a class="btn btn-primary" href="/plan">Plan my trip <Icon name="arrow" /></a>
        <a class="btn btn-ghost" href="/#tours">See journeys</a>
      </div>
    </div>
  </main>
  <Footer />
</Base>
<style>
  .nf { position: relative; isolation: isolate; overflow: hidden; min-height: 70vh; display: grid; align-items: center; }
  .nf :global(.nf-tiles) { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; -webkit-mask-image: radial-gradient(circle at 50% 50%, #000, transparent 70%); mask-image: radial-gradient(circle at 50% 50%, #000, transparent 70%); }
  .inner { padding-block: 80px; display: grid; gap: 18px; justify-items: center; text-align: center; }
  .code { font-family: var(--serif); font-size: 1.4rem; font-weight: 600; color: var(--gold-ink); }
  h1 { font-size: clamp(2.6rem, 6vw, 4.4rem); }
  .row { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 10px; }
</style>
